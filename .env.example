# Bellhop — Example Environment Variables
# Copy to `.env` for local runs or Docker Compose (`docker compose up -d`).
# Secrets can live here OR in `credentials.yaml` (`/config/credentials.yaml` in Docker).

# -----------------------------------------------------------------------------
# Container Runtime (Docker / Compose)
# -----------------------------------------------------------------------------
TZ=America/Montreal
PUID=1000
PGID=1000
BELLHOP_PORT=8080

# -----------------------------------------------------------------------------
# Bellhop Web Guide Login Credentials (`web_server`)
# Required when `web_server.enabled` is true; Web Guide login cannot be disabled.
# -----------------------------------------------------------------------------
BELLHOP_WEB_USERNAME=admin
BELLHOP_WEB_PASSWORD=change_me_web_password
# Optional static HMAC-SHA256 signing secret (auto-generated in cache if blank)
BELLHOP_WEB_SESSION_SECRET=

# -----------------------------------------------------------------------------
# Bellhop Passthrough Xtream Server Credentials (`xtream_server`)
# Used by external IPTV players (TiviMate, UHF, VLC, Kodi) hitting `bellhop serve`.
# -----------------------------------------------------------------------------
BELLHOP_SERVE_USERNAME=xtream_client
BELLHOP_SERVE_PASSWORD=change_me_xtream_password

# -----------------------------------------------------------------------------
# Upstream Xtream Codes IPTV Provider Credentials (`upstream_xtream`)
# -----------------------------------------------------------------------------
XTREAM_SERVER_URL=http://provider.example:8080
XTREAM_USERNAME=your_upstream_username
XTREAM_PASSWORD=your_upstream_password
XTREAM_STREAM_FORMAT=ts

# -----------------------------------------------------------------------------
# Optional: Schedules Direct Credentials (when backend is `schedules_direct`)
# -----------------------------------------------------------------------------
SD_USERNAME=
SD_PASSWORD=
